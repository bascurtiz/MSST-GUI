/* mvsep-style global stylesheet.
   Braced tokens are filled by ui/theme.build_stylesheet() for the active theme. */
* { outline: none; }
QWidget {
    font-family: {font_family};
    font-size: 12px;
    color: {text_sec};
    background: transparent;
}
QMainWindow { background: {bg}; }
QScrollBar:vertical {
    background: {scrollbar_bg};
    width: 5px; margin: 0;
}
QScrollBar::handle:vertical {
    background: {scrollbar_handle};
    border-radius: 2px; min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: {accent_glow}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: {scrollbar_bg}; height: 5px; margin: 0;
}
QScrollBar::handle:horizontal {
    background: {scrollbar_handle}; border-radius: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QToolTip {
    background: {tooltip_bg}; color: {tooltip_text};
    border: 1px solid {tooltip_border};
    padding: 4px 8px; border-radius: 4px; font-size: 11px;
}
QMenu {
    background: {menu_bg}; color: {menu_text};
    border: 1px solid {menu_border};
    border-radius: 6px; padding: 6px;
}
QMenu::item {
    background: transparent; color: {menu_text};
    padding: 7px 20px; border-radius: 4px;
    font-family: {font_family}; font-size: 11px;
}
QMenu::item:selected {
    background: {menu_hover}; color: #FFFFFF;
}
QMenu::item:disabled {
    color: {menu_disabled};
}
QMenu::separator {
    height: 1px; background: {menu_sep};
    margin: 5px 10px;
}
QMenu::icon { padding-left: 8px; }
QTextEdit#consoleLog {
    background: {console_bg}; color: {console_text};
    font-family: {mono_family}; font-size: 11px;
    border: none; padding: 10px 12px;
}

/* ── Interactive polish: hover/focus feedback on standard widgets ── */
QLineEdit:hover { color: {text}; }
QLineEdit:focus { color: {text}; }
QComboBox:hover { color: {text}; }
QComboBox QAbstractItemView {
    background: {surface};
    color: {text};
    border: 1px solid {border_visible};
    selection-background-color: {accent_soft};
    selection-color: {text};
    outline: none;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; }
QComboBox QAbstractItemView::item:hover {
    background: {accent_soft};
    color: {text};
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 2px solid {border_visible};
    border-radius: 4px;
    background: {surface_alt};
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: {accent};
    background: {accent_soft};
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: {accent};
    border-color: {accent};
}
QSlider::groove:horizontal {
    height: 4px;
    background: {border_dim};
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: {accent};
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px; height: 14px;
    margin: -5px 0;
    background: {surface};
    border: 2px solid {border_visible};
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    border-color: {accent};
    background: {accent_soft};
}
QPushButton:pressed { background: {accent_soft}; }
QComboBox::drop-down:hover {
    background: {accent_soft};
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QSpinBox:hover, QDoubleSpinBox:hover { color: {text}; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: {accent_soft};
}
QProgressBar {
    background: {border_dim};
    border: none; border-radius: 3px;
    text-align: center;
    color: {text_sec};
    font-size: 10px;
}
QProgressBar::chunk {
    background: {accent};
    border-radius: 3px;
}

/* ── Message boxes (delete confirmations etc.) ─────────────────────────
   Native boxes follow the OS dark/light mode, which mismatches the GUI
   theme and can render unreadable. Force the app palette instead. */
QMessageBox {
    background: {surface};
}
QMessageBox QLabel {
    background: transparent;
    color: {text};
    font-size: 12px;
}
QMessageBox QPushButton {
    background: {surface};
    color: {text};
    border: 1px solid {border_dim};
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 72px;
}
QMessageBox QPushButton:hover {
    color: {accent};
    border-color: {accent};
    background: {accent_soft};
}
QMessageBox QPushButton:default {
    background: {accent};
    color: {accent_text};
    border: none;
}
QMessageBox QPushButton:default:hover {
    background: {accent_hover};
}
